<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:PlanLite.Core.Models;assembly=PlanLite.Core">

    <!-- Initial Light fallback semantic brushes (updated dynamically at runtime by ThemeService) -->
    <SolidColorBrush x:Key="PlanPopupBackgroundBrush" Color="#F9FAFC" />
    <SolidColorBrush x:Key="PlanHeaderBackgroundBrush" Color="#F1F4F8" />
    <SolidColorBrush x:Key="PlanCardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PlanCardHoverBrush" Color="#F3F7FC" />
    <SolidColorBrush x:Key="PlanSubtleBorderBrush" Color="#E1E6EE" />
    <SolidColorBrush x:Key="PlanInputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PlanPrimaryTextBrush" Color="#181B22" />
    <SolidColorBrush x:Key="PlanSecondaryTextBrush" Color="#5A6270" />
    <SolidColorBrush x:Key="PlanMutedTextBrush" Color="#8B93A1" />
    <SolidColorBrush x:Key="PlanProgressTrackBrush" Color="#E5EAF1" />
    <SolidColorBrush x:Key="PlanAccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="PlanPrimaryButtonBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="PlanAccentSoftBrush" Color="#E8F2FC" />
    <SolidColorBrush x:Key="PlanSuccessBrush" Color="#107C41" />
    <SolidColorBrush x:Key="PlanSuccessSoftBrush" Color="#E6F4EC" />
    <SolidColorBrush x:Key="PlanDangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="PlanDangerSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="PlanOverlayBackdropBrush" Color="#66000000" />
    <SolidColorBrush x:Key="PlanMiniBackgroundBrush" Color="#FFFFFF" />

    <FontFamily x:Key="PlanFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>

    <!-- Task Card Border -->
    <Style x:Key="PlanCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PlanCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PlanSubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlanCardHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Section Container -->
    <Style x:Key="PlanSectionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PlanCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PlanSubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Status Pill Badge -->
    <Style x:Key="PlanStatusBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource PlanProgressTrackBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PlanTaskStatus.InProgress}">
                <Setter Property="Background" Value="{DynamicResource PlanAccentSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PlanTaskStatus.Completed}">
                <Setter Property="Background" Value="{DynamicResource PlanSuccessSoftBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlanStatusBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PlanMutedTextBrush}" />
        <Setter Property="Text" Value="未开始" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PlanTaskStatus.InProgress}">
                <Setter Property="Foreground" Value="{DynamicResource PlanAccentBrush}" />
                <Setter Property="Text" Value="进行中" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PlanTaskStatus.Completed}">
                <Setter Property="Foreground" Value="{DynamicResource PlanSuccessBrush}" />
                <Setter Property="Text" Value="已完成" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Sleek Progress Bar -->
    <Style x:Key="PlanProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource PlanAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource PlanProgressTrackBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track"
                                CornerRadius="2.5"
                                Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                CornerRadius="2.5"
                                Background="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Value" Value="100">
                            <Setter TargetName="PART_Indicator" Property="Background" Value="{DynamicResource PlanSuccessBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact Progress Slider -->
    <Style x:Key="PlanCompactSliderStyle" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="SmallChange" Value="5" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource PlanProgressTrackBrush}" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Focusable="False"
                                              IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4"
                                                    CornerRadius="2,0,0,2"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource PlanAccentBrush}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Focusable="False"
                                              IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="12" Height="12">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="ThumbDot"
                                                     Fill="{DynamicResource PlanAccentBrush}"
                                                     Stroke="{DynamicResource PlanCardBackgroundBrush}"
                                                     StrokeThickness="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbDot" Property="Width" Value="14" />
                                                    <Setter TargetName="ThumbDot" Property="Height" Value="14" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.65" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent Task ListBox (Supports clean card items + drag-drop without selection box) -->
    <Style x:Key="PlanTaskListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat Action Chip Button -->
    <Style x:Key="PlanChipButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PlanHeaderBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PlanPrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PlanSubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlanCardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Accent Button -->
    <Style x:Key="PlanPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PlanPrimaryButtonBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Subtle Text-Link / Title Click Button -->
    <Style x:Key="PlanGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
