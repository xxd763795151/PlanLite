<UserControl x:Class="PlanLite.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource PlanFontFamily}">
    <StackPanel>
        <!-- Appearance -->
        <Border Style="{StaticResource PlanSectionCardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="外观主题"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PlanPrimaryTextBrush}"
                           Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0"
                                 Content="跟随系统"
                                 GroupName="ThemeModeGroup"
                                 IsChecked="{Binding ThemeMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=System}"
                                 Command="{Binding SelectThemeCommand}"
                                 CommandParameter="System" />
                    <RadioButton Grid.Column="1"
                                 Content="浅色"
                                 GroupName="ThemeModeGroup"
                                 IsChecked="{Binding ThemeMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Light}"
                                 Command="{Binding SelectThemeCommand}"
                                 CommandParameter="Light" />
                    <RadioButton Grid.Column="2"
                                 Content="深色"
                                 GroupName="ThemeModeGroup"
                                 IsChecked="{Binding ThemeMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}"
                                 Command="{Binding SelectThemeCommand}"
                                 CommandParameter="Dark" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Window & Startup Behavior -->
        <Border Style="{StaticResource PlanSectionCardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="窗口与启动"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PlanPrimaryTextBrush}"
                           Margin="0,0,0,8" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="固定主窗口" FontSize="12.5" Foreground="{DynamicResource PlanPrimaryTextBrush}" />
                        <TextBlock Text="固定后点击窗口外部不会自动隐藏" FontSize="11" Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsWindowPinned, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="迷你悬浮窗" FontSize="12.5" Foreground="{DynamicResource PlanPrimaryTextBrush}" />
                        <TextBlock Text="在桌面边缘显示今日进度与当前任务" FontSize="11" Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsMiniWidgetEnabled, Mode=TwoWay}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="开机自动启动" FontSize="12.5" Foreground="{DynamicResource PlanPrimaryTextBrush}" />
                        <TextBlock Text="登录 Windows 时自动在托盘静默运行" FontSize="11" Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" />
                </Grid>

                <TextBlock Text="{Binding StartupErrorMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource PlanDangerBrush}"
                           Margin="0,6,0,0"
                           Visibility="{Binding StartupErrorMessage, Converter={StaticResource NotEmptyToVis}}" />
            </StackPanel>
        </Border>

        <!-- Global Hotkey -->
        <Border Style="{StaticResource PlanSectionCardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="全局唤出快捷键" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PlanPrimaryTextBrush}" />
                        <TextBlock Text="随时呼出或收起 PlanLite 窗口" FontSize="11" Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding HotkeyEnabled, Mode=TwoWay}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HotkeyCaptureBox"
                             Text="{Binding HotkeyDisplayText, Mode=OneWay}"
                             IsReadOnly="True"
                             PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"
                             ToolTip="点击输入框后直接按下新的组合键（例如 Ctrl + Alt + P）"
                             FontSize="12.5"
                             FontWeight="SemiBold"
                             Padding="8,5"
                             Cursor="Hand" />
                    <Button Grid.Column="1"
                            Content="恢复默认"
                            Command="{Binding ResetDefaultHotkeyCommand}"
                            Style="{StaticResource PlanChipButtonStyle}"
                            Margin="6,0,0,0" />
                </Grid>

                <TextBlock Text="{Binding HotkeyStatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource PlanSecondaryTextBrush}"
                           Margin="0,5,0,0"
                           Visibility="{Binding HasHotkeyError, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                <TextBlock Text="{Binding HotkeyStatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource PlanDangerBrush}"
                           Margin="0,5,0,0"
                           Visibility="{Binding HasHotkeyError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- Storage & Backup -->
        <Border Style="{StaticResource PlanSectionCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="数据存储与备份"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PlanPrimaryTextBrush}" />
                    <Border Grid.Column="1"
                            Background="{DynamicResource PlanAccentSoftBrush}"
                            CornerRadius="7"
                            Padding="6,2">
                        <TextBlock Text="{Binding StorageModeText}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PlanAccentBrush}" />
                    </Border>
                </Grid>

                <TextBox Text="{Binding DataDirectoryPath, Mode=OneWay}"
                         IsReadOnly="True"
                         FontSize="11"
                         Padding="6,4"
                         Margin="0,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Command="{Binding OpenDataFolderCommand}"
                            Style="{StaticResource PlanChipButtonStyle}"
                            Margin="0,0,6,0"
                            Padding="9,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen20" FontSize="13" />
                            <TextBlock Text="打开目录" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1"
                            Command="{Binding BackupDataCommand}"
                            Style="{StaticResource PlanPrimaryButtonStyle}"
                            Margin="0,0,6,0"
                            Padding="9,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="13" />
                            <TextBlock Text="备份数据" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Command="{Binding RequestRestoreBackupCommand}"
                            Style="{StaticResource PlanChipButtonStyle}"
                            Padding="9,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" />
                            <TextBlock Text="恢复数据" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Inline Backup Restore Confirmation -->
                <Border Margin="0,10,0,0"
                        Background="{DynamicResource PlanDangerSoftBrush}"
                        CornerRadius="8"
                        Padding="10,8"
                        Visibility="{Binding PendingRestorePath, Converter={StaticResource NotEmptyToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding PendingRestoreFileName, StringFormat=将从 {0} 恢复全部数据并覆盖当前计划（已自动保留恢复前副本），是否继续？}"
                                   TextWrapping="Wrap"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource PlanDangerBrush}"
                                   Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消"
                                    Command="{Binding CancelRestoreBackupCommand}"
                                    Style="{StaticResource PlanChipButtonStyle}"
                                    Margin="0,0,6,0" />
                            <Button Content="确认恢复"
                                    Command="{Binding ConfirmRestoreBackupCommand}"
                                    Style="{StaticResource PlanPrimaryButtonStyle}"
                                    Background="{DynamicResource PlanDangerBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
