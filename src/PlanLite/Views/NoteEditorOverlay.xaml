<UserControl x:Class="PlanLite.Views.NoteEditorOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource PlanFontFamily}">
    <Grid Background="{DynamicResource PlanOverlayBackdropBrush}"
          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
        <Border Margin="14,20"
                VerticalAlignment="Center"
                Background="{DynamicResource PlanPopupBackgroundBrush}"
                BorderBrush="{DynamicResource PlanSubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="4"
                                  Opacity="0.28"
                                  Color="#000000" />
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding HeaderSubtitle}"
                                       FontSize="11"
                                       Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                            <TextBlock Text="{Binding HeaderTitle}"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PlanPrimaryTextBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CloseCommand}"
                                Style="{StaticResource PlanChipButtonStyle}"
                                Padding="6"
                                ToolTip="关闭 (Esc)">
                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" />
                        </Button>
                    </Grid>

                    <!-- Title -->
                    <TextBlock Text="笔记标题"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PlanSecondaryTextBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13"
                             Padding="8,6"
                             MaxLength="200" />
                    <TextBlock Text="{Binding ValidationMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource PlanDangerBrush}"
                               Margin="0,3,0,0"
                               Visibility="{Binding ValidationMessage, Converter={StaticResource NotEmptyToVis}}" />

                    <!-- Category & Quick Flags -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="分类"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PlanSecondaryTextBrush}"
                                       Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding CategoryOptions}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="Name"
                                      FontSize="12" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding TogglePinCommand}"
                                VerticalAlignment="Bottom"
                                Padding="8,6"
                                Margin="0,0,5,0"
                                ToolTip="置顶常用笔记">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PlanChipButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PlanAccentSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PlanAccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Pin20" FontSize="13">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource PlanSecondaryTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource PlanAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock Text="置顶" FontSize="11.5" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Command="{Binding ToggleMaskCommand}"
                                VerticalAlignment="Bottom"
                                Padding="8,6"
                                ToolTip="防肩窥隐私遮罩（账号/密码推荐开启，仍可一键复制）">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PlanChipButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PlanAccentSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PlanAccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="EyeOff20" FontSize="13">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource PlanSecondaryTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource PlanAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock Text="遮罩" FontSize="11.5" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Content Header -->
                    <Grid Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="正文内容（保留原始缩进与换行）"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                        <Button Grid.Column="1"
                                Command="{Binding ToggleRevealContentCommand}"
                                Style="{StaticResource PlanChipButtonStyle}"
                                Padding="7,3"
                                Visibility="{Binding IsMasked, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="12">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Eye20" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsContentRevealed}" Value="True">
                                                    <Setter Property="Symbol" Value="EyeOff20" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock FontSize="11" Margin="4,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="显示正文" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsContentRevealed}" Value="True">
                                                    <Setter Property="Text" Value="隐藏正文" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Masked Placeholder -->
                    <Border Style="{StaticResource PlanSectionCardStyle}"
                            MinHeight="120"
                            Visibility="{Binding ShowMaskedPlaceholder, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,10">
                            <TextBlock Text="••••••••••••••"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                            <TextBlock Text="此笔记已开启防肩窥遮罩，可直接复制或点击查看明文"
                                       FontSize="11.5"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PlanMutedTextBrush}"
                                       Margin="0,6,0,10" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Command="{Binding ToggleRevealContentCommand}"
                                        Style="{StaticResource PlanChipButtonStyle}"
                                        Padding="10,5"
                                        Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Eye20" FontSize="13" />
                                        <TextBlock Text="显示正文" FontSize="11.5" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CopyContentCommand}"
                                        Style="{StaticResource PlanPrimaryButtonStyle}"
                                        Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Copy20" FontSize="13" />
                                        <TextBlock Text="一键复制" FontSize="11.5" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Plaintext Editor -->
                    <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowMaskedPlaceholder, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             MinHeight="140"
                             MaxHeight="240"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="12.5"
                             Padding="8,6" />

                    <!-- Footer Actions -->
                    <Grid Margin="0,14,0,0"
                          Visibility="{Binding IsDeleteConfirmVisible, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding CopyContentCommand}"
                                Style="{StaticResource PlanChipButtonStyle}"
                                Padding="9,5"
                                ToolTip="复制正文到剪贴板">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Copy20" FontSize="13" />
                                <TextBlock Text="复制正文" FontSize="11.5" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Command="{Binding RequestDeleteCommand}"
                                Style="{StaticResource PlanChipButtonStyle}"
                                Margin="0,0,6,0"
                                Padding="9,5"
                                Visibility="{Binding IsNewNote, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete20" FontSize="13" Foreground="{DynamicResource PlanDangerBrush}" />
                                <TextBlock Text="删除"
                                           Margin="4,0,0,0"
                                           Foreground="{DynamicResource PlanDangerBrush}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3"
                                Content="完成"
                                Command="{Binding SaveAndCloseCommand}"
                                Style="{StaticResource PlanPrimaryButtonStyle}"
                                Padding="14,5" />
                    </Grid>

                    <!-- Inline Delete Confirmation -->
                    <Border Margin="0,14,0,0"
                            Background="{DynamicResource PlanDangerSoftBrush}"
                            CornerRadius="8"
                            Padding="10,8"
                            Visibility="{Binding IsDeleteConfirmVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="确定删除此笔记？"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PlanDangerBrush}" />
                            <Button Grid.Column="1"
                                    Content="取消"
                                    Command="{Binding CancelDeleteCommand}"
                                    Style="{StaticResource PlanChipButtonStyle}"
                                    Margin="0,0,6,0" />
                            <Button Grid.Column="2"
                                    Content="确认删除"
                                    Command="{Binding ConfirmDeleteCommand}"
                                    Style="{StaticResource PlanPrimaryButtonStyle}"
                                    Background="{DynamicResource PlanDangerBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
