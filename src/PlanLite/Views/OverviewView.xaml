<UserControl x:Class="PlanLite.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource PlanFontFamily}">
    <StackPanel>
        <!-- Weekly Plan Section -->
        <Border Style="{StaticResource PlanSectionCardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="本周计划"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PlanPrimaryTextBrush}" />
                        <TextBlock Text="{Binding WeekHeaderLabel}"
                                   FontSize="11"
                                   Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding OpenThisWeekTabCommand}"
                            Style="{StaticResource PlanChipButtonStyle}"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="管理" FontSize="11" />
                            <ui:SymbolIcon Symbol="ChevronRight20" FontSize="12" Margin="2,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Value="{Binding WeeklyAverageProgress, Mode=OneWay}"
                                 Style="{StaticResource PlanProgressBarStyle}"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding WeeklySummaryText}"
                               FontSize="11"
                               Foreground="{DynamicResource PlanSecondaryTextBrush}"
                               Margin="8,0,0,0" />
                </Grid>

                <TextBlock Text="本周暂无计划，点击“管理”或切换至“本周”制定目标"
                           FontSize="11.5"
                           Foreground="{DynamicResource PlanMutedTextBrush}"
                           Margin="0,4,0,2"
                           Visibility="{Binding HasWeeklyTasks, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                <ItemsControl ItemsSource="{Binding UnfinishedWeeklyTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PlanCardStyle}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding OpenEditorCommand}"
                                                Style="{StaticResource PlanGhostButtonStyle}">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12.5"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource PlanPrimaryTextBrush}" />
                                        </Button>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource PlanHeaderBackgroundBrush}"
                                                CornerRadius="6"
                                                Padding="5,1"
                                                Margin="6,0,4,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ModeLabel}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource PlanStatusBadgeStyle}">
                                            <TextBlock Style="{StaticResource PlanStatusBadgeTextStyle}" />
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                                     Style="{StaticResource PlanProgressBarStyle}"
                                                     VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Progress, StringFormat={}{0}%}"
                                                   HorizontalAlignment="Right"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Completed Weekly Collapsible -->
                <StackPanel Visibility="{Binding HasCompletedWeeklyTasks, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding ToggleCompletedWeeklyExpandedCommand}"
                            Style="{StaticResource PlanGhostButtonStyle}"
                            Margin="0,2,0,4">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark20" FontSize="12" Foreground="{DynamicResource PlanSuccessBrush}" />
                            <TextBlock Text="{Binding CompletedWeeklyTasks.Count, StringFormat=已完成 ({0})}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource PlanSecondaryTextBrush}"
                                       Margin="4,0,4,0" />
                            <TextBlock Text="展开/收起"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource PlanMutedTextBrush}" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding CompletedWeeklyTasks}"
                                  Visibility="{Binding IsCompletedWeeklyExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PlanCardStyle}"
                                        Opacity="0.65"
                                        Padding="8,6"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding OpenEditorCommand}"
                                                Style="{StaticResource PlanGhostButtonStyle}">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       TextDecorations="Strikethrough"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                                        </Button>
                                        <TextBlock Grid.Column="1"
                                                   Text="100%"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource PlanSuccessBrush}"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Today Plan Section -->
        <Border Style="{StaticResource PlanSectionCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="今日计划"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PlanPrimaryTextBrush}" />
                    <Button Grid.Column="1"
                            Command="{Binding OpenTodayTabCommand}"
                            Style="{StaticResource PlanChipButtonStyle}"
                            Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="详情" FontSize="11" />
                            <ui:SymbolIcon Symbol="ChevronRight20" FontSize="12" Margin="2,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Value="{Binding DailyAverageProgress, Mode=OneWay}"
                                 Style="{StaticResource PlanProgressBarStyle}"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DailySummaryText}"
                               FontSize="11"
                               Foreground="{DynamicResource PlanSecondaryTextBrush}"
                               Margin="8,0,0,0" />
                </Grid>

                <!-- Quick Add Today -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding QuickDailyTitle, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="快捷添加今日任务，回车确认..."
                                FontSize="12.5"
                                Padding="8,5">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding QuickAddDailyTaskCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <Button Grid.Column="1"
                            Command="{Binding QuickAddDailyTaskCommand}"
                            Style="{StaticResource PlanPrimaryButtonStyle}"
                            Margin="6,0,0,0"
                            Padding="10,6"
                            ToolTip="添加任务">
                        <ui:SymbolIcon Symbol="Add20" FontSize="14" />
                    </Button>
                </Grid>

                <TextBlock Text="今日暂无工作计划，在上方输入一条开始吧"
                           FontSize="11.5"
                           Foreground="{DynamicResource PlanMutedTextBrush}"
                           Margin="0,2,0,2"
                           Visibility="{Binding HasDailyTasks, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                <ItemsControl ItemsSource="{Binding UnfinishedDailyTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PlanCardStyle}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                  Command="{Binding ToggleCompleteCommand}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"
                                                  ToolTip="快速标记完成" />
                                        <Button Grid.Column="1"
                                                Command="{Binding OpenEditorCommand}"
                                                Style="{StaticResource PlanGhostButtonStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12.5"
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource PlanPrimaryTextBrush}" />
                                                <TextBlock Text="{Binding WeeklyTaskTitle, StringFormat=↳ {0}}"
                                                           FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource PlanAccentBrush}"
                                                           Visibility="{Binding HasWeeklyLink, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Button>
                                        <Border Grid.Column="2" Style="{StaticResource PlanStatusBadgeStyle}">
                                            <TextBlock Style="{StaticResource PlanStatusBadgeTextStyle}" />
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="26,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Value="{Binding Progress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource PlanCompactSliderStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Progress, StringFormat={}{0}%}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Completed Daily Collapsible -->
                <StackPanel Visibility="{Binding HasCompletedDailyTasks, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding ToggleCompletedDailyExpandedCommand}"
                            Style="{StaticResource PlanGhostButtonStyle}"
                            Margin="0,2,0,4">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark20" FontSize="12" Foreground="{DynamicResource PlanSuccessBrush}" />
                            <TextBlock Text="{Binding CompletedDailyTasks.Count, StringFormat=已完成 ({0})}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource PlanSecondaryTextBrush}"
                                       Margin="4,0,4,0" />
                            <TextBlock Text="展开/收起"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource PlanMutedTextBrush}" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding CompletedDailyTasks}"
                                  Visibility="{Binding IsCompletedDailyExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PlanCardStyle}"
                                        Opacity="0.64"
                                        Padding="8,6"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                  Command="{Binding ToggleCompleteCommand}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                                        <Button Grid.Column="1"
                                                Command="{Binding OpenEditorCommand}"
                                                Style="{StaticResource PlanGhostButtonStyle}">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       TextDecorations="Strikethrough"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                                        </Button>
                                        <TextBlock Grid.Column="2"
                                                   Text="100%"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource PlanSuccessBrush}"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
