<Window x:Class="PlanLite.Views.MiniWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PlanLite Mini"
        Width="228"
        Height="66"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource PlanMiniBackgroundBrush}"
        FontFamily="{StaticResource PlanFontFamily}"
        MouseLeftButtonDown="OnWidgetMouseLeftButtonDown"
        MouseMove="OnWidgetMouseMove"
        MouseLeftButtonUp="OnWidgetMouseLeftButtonUp">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource PlanSubtleBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource PlanMiniBackgroundBrush}"
            Padding="10,8"
            Cursor="Hand"
            ToolTip="点击展开 PlanLite · 按住拖动可停靠边缘">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource PlanAccentSoftBrush}"
                        CornerRadius="6"
                        Padding="6,1">
                    <TextBlock Text="{Binding CountBadgeText}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PlanAccentBrush}" />
                </Border>
                <TextBlock Grid.Column="2"
                           Text="{Binding ProgressText}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PlanPrimaryTextBrush}" />
            </Grid>

            <ProgressBar Grid.Row="1"
                         Value="{Binding AverageProgress}"
                         Style="{StaticResource PlanProgressBarStyle}"
                         Height="4"
                         Margin="0,5,0,5" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ActiveTaskTitle}"
                           FontSize="11.5"
                           FontWeight="Medium"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource PlanPrimaryTextBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusBadgeText}"
                           FontSize="10.5"
                           Foreground="{DynamicResource PlanSecondaryTextBrush}"
                           Margin="6,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
