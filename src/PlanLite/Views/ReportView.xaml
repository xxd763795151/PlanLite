<UserControl x:Class="PlanLite.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource PlanFontFamily}">
    <StackPanel>
        <Border Style="{StaticResource PlanSectionCardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0"
                                 Content="工作日报"
                                 IsChecked="{Binding IsDailyReport, Mode=OneWay}"
                                 Command="{Binding SwitchReportKindCommand}"
                                 CommandParameter="Daily"
                                 GroupName="ReportKind"
                                 Margin="0,0,4,0" />
                    <RadioButton Grid.Column="1"
                                 Content="工作周报"
                                 IsChecked="{Binding IsDailyReport, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=False}"
                                 Command="{Binding SwitchReportKindCommand}"
                                 CommandParameter="Weekly"
                                 GroupName="ReportKind"
                                 Margin="4,0,0,0" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding PreviousPeriodCommand}"
                            Style="{StaticResource PlanChipButtonStyle}"
                            Padding="7,5">
                        <ui:SymbolIcon Symbol="ChevronLeft20" FontSize="13" />
                    </Button>
                    <TextBlock Grid.Column="1"
                               Text="{Binding PeriodLabel}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PlanPrimaryTextBrush}"
                               Margin="6,0" />
                    <Button Grid.Column="2"
                            Content="当前"
                            Command="{Binding GoToCurrentPeriodCommand}"
                            Style="{StaticResource PlanChipButtonStyle}"
                            Margin="0,0,5,0" />
                    <Button Grid.Column="3"
                            Command="{Binding NextPeriodCommand}"
                            Style="{StaticResource PlanChipButtonStyle}"
                            Padding="7,5">
                        <ui:SymbolIcon Symbol="ChevronRight20" FontSize="13" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource PlanSectionCardStyle}" Margin="0,0,0,10" Padding="10">
            <TextBox Text="{Binding ReportMarkdown, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="230"
                     MaxHeight="300"
                     FontFamily="Consolas, Microsoft YaHei UI"
                     FontSize="12"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource PlanPrimaryTextBrush}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Command="{Binding CopyToClipboardCommand}"
                    Style="{StaticResource PlanPrimaryButtonStyle}"
                    Margin="0,0,5,0"
                    Padding="10,7">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Copy20" FontSize="14" />
                    <TextBlock Text="一键复制 Markdown" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1"
                    Command="{Binding ExportMarkdownCommand}"
                    Style="{StaticResource PlanChipButtonStyle}"
                    Margin="5,0,0,0"
                    Padding="10,7">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Save20" FontSize="14" />
                    <TextBlock Text="导出 .md 文件" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
