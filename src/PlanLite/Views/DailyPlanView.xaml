<UserControl x:Class="PlanLite.Views.DailyPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:PlanLite.Helpers"
             FontFamily="{StaticResource PlanFontFamily}">
    <StackPanel>
        <!-- Date Navigation & Summary -->
        <Border Style="{StaticResource PlanSectionCardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding PreviousDayCommand}"
                            Style="{StaticResource PlanChipButtonStyle}"
                            Padding="7,5"
                            ToolTip="前一天">
                        <ui:SymbolIcon Symbol="ChevronLeft20" FontSize="13" />
                    </Button>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SelectedDateLabel}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PlanPrimaryTextBrush}" />
                            <Border Background="{DynamicResource PlanAccentSoftBrush}"
                                    CornerRadius="8"
                                    Padding="6,1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding PeriodBadgeText}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PlanAccentBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="今天"
                            Command="{Binding GoToTodayCommand}"
                            Style="{StaticResource PlanChipButtonStyle}"
                            Margin="0,0,5,0" />
                    <Button Grid.Column="3"
                            Command="{Binding NextDayCommand}"
                            Style="{StaticResource PlanChipButtonStyle}"
                            Padding="7,5"
                            ToolTip="后一天">
                        <ui:SymbolIcon Symbol="ChevronRight20" FontSize="13" />
                    </Button>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Value="{Binding AverageProgress, Mode=OneWay}"
                                 Style="{StaticResource PlanProgressBarStyle}"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SummaryText}"
                               FontSize="11"
                               Foreground="{DynamicResource PlanSecondaryTextBrush}"
                               Margin="8,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Quick Add + Weekly Link -->
        <Border Style="{StaticResource PlanSectionCardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="添加每日工作计划..."
                                FontSize="12.5"
                                Padding="8,5">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddTaskCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <Button Grid.Column="1"
                            Command="{Binding AddTaskCommand}"
                            Style="{StaticResource PlanPrimaryButtonStyle}"
                            Margin="6,0,0,0"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add20" FontSize="13" />
                            <TextBlock Text="添加" Margin="4,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="关联周计划:"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PlanSecondaryTextBrush}"
                               Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding WeeklyLinkOptions}"
                              SelectedItem="{Binding SelectedWeeklyLink}"
                              DisplayMemberPath="Title"
                              FontSize="11.5" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Action Row: Carry-over & Drag Hint -->
        <Grid Margin="2,0,2,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="拖动卡片可调整顺序 · 点击标题编辑"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PlanMutedTextBrush}" />
            <Button Grid.Column="1"
                    Command="{Binding CarryOverToNextDayCommand}"
                    Style="{StaticResource PlanChipButtonStyle}"
                    Padding="8,4"
                    ToolTip="保留今日记录并将未完成任务结转至下一天">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowForward20" FontSize="12" />
                    <TextBlock Text="结转未完成至下一天" FontSize="11" Margin="4,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Empty State -->
        <Border Style="{StaticResource PlanSectionCardStyle}"
                Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <TextBlock Text="当天还没有安排工作计划，请在上方添加任务"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource PlanMutedTextBrush}"
                       Margin="0,10" />
        </Border>

        <!-- Unfinished Tasks (Drag & Drop Reorderable) -->
        <ListBox ItemsSource="{Binding UnfinishedTasks}"
                 Style="{StaticResource PlanTaskListBoxStyle}"
                 helpers:ListBoxDragDropBehavior.ReorderCommand="{Binding ReorderUnfinishedCommand}"
                 Visibility="{Binding HasUnfinishedTasks, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PlanCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                          Command="{Binding ToggleCompleteCommand}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                                <Button Grid.Column="1"
                                        Command="{Binding OpenEditorCommand}"
                                        Style="{StaticResource PlanGhostButtonStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12.5"
                                                   FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PlanPrimaryTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding WeeklyTaskTitle, StringFormat=关联: {0}}"
                                                       FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="190"
                                                       Foreground="{DynamicResource PlanAccentBrush}"
                                                       Margin="0,0,8,0"
                                                       Visibility="{Binding HasWeeklyLink, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="有备注"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource PlanMutedTextBrush}"
                                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Border Grid.Column="2" Style="{StaticResource PlanStatusBadgeStyle}">
                                    <TextBlock Style="{StaticResource PlanStatusBadgeTextStyle}" />
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="26,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Slider Value="{Binding Progress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource PlanCompactSliderStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Progress, StringFormat={}{0}%}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Completed Tasks (Collapsible) -->
        <StackPanel Visibility="{Binding HasCompletedTasks, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
            <Button Command="{Binding ToggleCompletedExpandedCommand}"
                    Style="{StaticResource PlanGhostButtonStyle}"
                    Margin="2,2,0,6">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Checkmark20" FontSize="12" Foreground="{DynamicResource PlanSuccessBrush}" />
                    <TextBlock Text="{Binding CompletedTasks.Count, StringFormat=已完成任务 ({0})}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{DynamicResource PlanSecondaryTextBrush}"
                               Margin="5,0,6,0" />
                    <TextBlock Text="点击展开/收起"
                               FontSize="10.5"
                               Foreground="{DynamicResource PlanMutedTextBrush}" />
                </StackPanel>
            </Button>

            <ItemsControl ItemsSource="{Binding CompletedTasks}"
                          Visibility="{Binding IsCompletedExpanded, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PlanCardStyle}"
                                Opacity="0.64"
                                Padding="10,7"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                          Command="{Binding ToggleCompleteCommand}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                                <Button Grid.Column="1"
                                        Command="{Binding OpenEditorCommand}"
                                        Style="{StaticResource PlanGhostButtonStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   TextDecorations="Strikethrough"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                                        <TextBlock Text="{Binding WeeklyTaskTitle, StringFormat=关联: {0}}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource PlanMutedTextBrush}"
                                                   Visibility="{Binding HasWeeklyLink, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="2"
                                           Text="100%"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PlanSuccessBrush}"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
