<UserControl x:Class="PlanLite.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:PlanLite.Core.Models;assembly=PlanLite.Core"
             FontFamily="{StaticResource PlanFontFamily}">
    <StackPanel>
        <!-- Search & Quick Actions -->
        <Border Style="{StaticResource PlanSectionCardStyle}" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource PlanInputBackgroundBrush}"
                            BorderBrush="{DynamicResource PlanSubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Search20"
                                           FontSize="13.5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PlanMutedTextBrush}"
                                           Margin="0,0,6,0" />
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="搜索标题或正文（空格多词）..."
                                        FontSize="12"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Padding="0,2">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchNowCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                            <Button Grid.Column="2"
                                    Content="清空"
                                    Command="{Binding ClearSearchCommand}"
                                    Style="{StaticResource PlanChipButtonStyle}"
                                    Padding="6,2"
                                    FontSize="11"
                                    Margin="4,0,0,0"
                                    Visibility="{Binding SearchKeyword, Converter={StaticResource NotEmptyToVis}}" />
                        </Grid>
                    </Border>

                    <Button Grid.Column="1"
                            Command="{Binding NewNoteCommand}"
                            Style="{StaticResource PlanPrimaryButtonStyle}"
                            Margin="6,0,0,0"
                            Padding="10,6"
                            ToolTip="新建一条笔记">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add20" FontSize="13" />
                            <TextBlock Text="新建" Margin="4,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Search Scope + Category Manager Toggle -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="范围:"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PlanMutedTextBrush}"
                               Margin="0,0,6,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="标题+正文"
                                     GroupName="NoteSearchScope"
                                     IsChecked="{Binding SearchScope, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=All}"
                                     Command="{Binding SelectSearchScopeCommand}"
                                     CommandParameter="All"
                                     Margin="0,0,4,0">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource PlanHeaderBackgroundBrush}"
                                            BorderBrush="{DynamicResource PlanSubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="7,3"
                                            Cursor="Hand">
                                        <TextBlock x:Name="Txt"
                                                   Text="{TemplateBinding Content}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlanAccentSoftBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PlanAccentBrush}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PlanAccentBrush}" />
                                            <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <RadioButton Content="仅标题"
                                     GroupName="NoteSearchScope"
                                     IsChecked="{Binding SearchScope, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=TitleOnly}"
                                     Command="{Binding SelectSearchScopeCommand}"
                                     CommandParameter="TitleOnly"
                                     Margin="0,0,4,0">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource PlanHeaderBackgroundBrush}"
                                            BorderBrush="{DynamicResource PlanSubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="7,3"
                                            Cursor="Hand">
                                        <TextBlock x:Name="Txt"
                                                   Text="{TemplateBinding Content}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlanAccentSoftBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PlanAccentBrush}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PlanAccentBrush}" />
                                            <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <RadioButton Content="仅正文"
                                     GroupName="NoteSearchScope"
                                     IsChecked="{Binding SearchScope, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=ContentOnly}"
                                     Command="{Binding SelectSearchScopeCommand}"
                                     CommandParameter="ContentOnly">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource PlanHeaderBackgroundBrush}"
                                            BorderBrush="{DynamicResource PlanSubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="7,3"
                                            Cursor="Hand">
                                        <TextBlock x:Name="Txt"
                                                   Text="{TemplateBinding Content}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlanAccentSoftBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PlanAccentBrush}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PlanAccentBrush}" />
                                            <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Command="{Binding ToggleCategoryManagerCommand}"
                            Padding="7,3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlanChipButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCategoryManagerOpen}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PlanAccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PlanAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Tag20" FontSize="12" />
                            <TextBlock Text="分类管理" FontSize="10.5" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Inline Category Manager Panel -->
        <Border Style="{StaticResource PlanSectionCardStyle}"
                Margin="0,0,0,8"
                Visibility="{Binding IsCategoryManagerOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="分类管理（删除分类后，对应笔记将保留并归入“其它”）"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                    <Button Grid.Column="1"
                            Content="收起"
                            Command="{Binding ToggleCategoryManagerCommand}"
                            Style="{StaticResource PlanChipButtonStyle}"
                            Padding="6,2"
                            FontSize="10.5" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="输入新分类名称（最多 20 字）..."
                                FontSize="12"
                                MaxLength="20"
                                Padding="8,4">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddCategoryCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <Button Grid.Column="1"
                            Content="添加分类"
                            Command="{Binding AddCategoryCommand}"
                            Style="{StaticResource PlanPrimaryButtonStyle}"
                            Margin="6,0,0,0"
                            Padding="10,5"
                            FontSize="11.5" />
                </Grid>

                <TextBlock Text="{Binding CategoryErrorMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource PlanDangerBrush}"
                           Margin="0,0,0,6"
                           Visibility="{Binding CategoryErrorMessage, Converter={StaticResource NotEmptyToVis}}" />

                <ItemsControl ItemsSource="{Binding ManageCategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PlanHeaderBackgroundBrush}"
                                    CornerRadius="6"
                                    Padding="8,5"
                                    Margin="0,0,0,5">
                                <StackPanel>
                                    <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PlanPrimaryTextBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CountLabel}"
                                                   FontSize="10.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PlanMutedTextBrush}"
                                                   Margin="6,0,8,0" />
                                        <Button Grid.Column="2"
                                                Command="{Binding DataContext.BeginRenameCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PlanChipButtonStyle}"
                                                Padding="6,3"
                                                Margin="0,0,4,0"
                                                ToolTip="重命名">
                                            <ui:SymbolIcon Symbol="Edit20" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="3"
                                                Command="{Binding DataContext.RequestDeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PlanChipButtonStyle}"
                                                Padding="6,3"
                                                ToolTip="删除分类">
                                            <ui:SymbolIcon Symbol="Delete20" FontSize="12" Foreground="{DynamicResource PlanDangerBrush}" />
                                        </Button>
                                    </Grid>

                                    <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12"
                                                 MaxLength="20"
                                                 Padding="6,3" />
                                        <Button Grid.Column="1"
                                                Content="保存"
                                                Command="{Binding DataContext.SaveRenameCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PlanPrimaryButtonStyle}"
                                                Padding="8,3"
                                                FontSize="11"
                                                Margin="6,0,4,0" />
                                        <Button Grid.Column="2"
                                                Content="取消"
                                                Command="{Binding DataContext.CancelRenameCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PlanChipButtonStyle}"
                                                Padding="7,3"
                                                FontSize="11" />
                                    </Grid>

                                    <Border Background="{DynamicResource PlanDangerSoftBrush}"
                                            CornerRadius="6"
                                            Padding="8,5"
                                            Margin="0,5,0,0"
                                            Visibility="{Binding IsDeleteConfirming, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="确认删除此分类？"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PlanDangerBrush}" />
                                            <Button Grid.Column="1"
                                                    Content="取消"
                                                    Command="{Binding DataContext.CancelDeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PlanChipButtonStyle}"
                                                    Padding="6,2"
                                                    FontSize="10.5"
                                                    Margin="0,0,4,0" />
                                            <Button Grid.Column="2"
                                                    Content="确认删除"
                                                    Command="{Binding DataContext.ConfirmDeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PlanPrimaryButtonStyle}"
                                                    Background="{DynamicResource PlanDangerBrush}"
                                                    Padding="7,2"
                                                    FontSize="10.5" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Category Filter Chips -->
        <ItemsControl ItemsSource="{Binding CategoryFilters}" Margin="0,0,0,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.SelectCategoryFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Margin="0,0,5,5"
                            Padding="8,3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlanChipButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PlanAccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PlanAccentBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PlanAccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding DisplayLabel}" FontSize="11" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Status Summary -->
        <TextBlock Text="{Binding StatusSummaryText}"
                   FontSize="11"
                   Foreground="{DynamicResource PlanMutedTextBrush}"
                   Margin="2,0,2,6"
                   Visibility="{Binding StatusSummaryText, Converter={StaticResource NotEmptyToVis}}" />

        <!-- Empty State -->
        <Border Style="{StaticResource PlanSectionCardStyle}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding EmptyText}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource PlanMutedTextBrush}"
                       Margin="8,14" />
        </Border>

        <!-- Notes Cards -->
        <ItemsControl ItemsSource="{Binding Notes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PlanCardStyle}" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Clickable Body (no nested buttons) -->
                            <Button Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource PlanGhostButtonStyle}"
                                    HorizontalContentAlignment="Stretch">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Symbol="Pin20"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PlanAccentBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PlanPrimaryTextBrush}" />

                                        <Border Grid.Column="2"
                                                Background="{DynamicResource PlanHeaderBackgroundBrush}"
                                                CornerRadius="5"
                                                Padding="5,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryLabel}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding PreviewText}"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource PlanSecondaryTextBrush}"
                                               Margin="0,4,0,0" />

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="更新于 "
                                                   FontSize="10"
                                                   Foreground="{DynamicResource PlanMutedTextBrush}" />
                                        <TextBlock Text="{Binding UpdatedDisplayText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource PlanMutedTextBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Right Quick Actions -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Top"
                                        Margin="8,0,0,0">
                                <Button Command="{Binding DataContext.TogglePinNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="6,5"
                                        Margin="0,0,4,0"
                                        ToolTip="{Binding PinTooltip}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PlanChipButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PlanAccentSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PlanAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <ui:SymbolIcon Symbol="Pin20" FontSize="12.5">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource PlanSecondaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource PlanAccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Button>

                                <Button Command="{Binding DataContext.CopyNoteContentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource PlanChipButtonStyle}"
                                        Padding="6,5"
                                        ToolTip="一键复制正文内容">
                                    <ui:SymbolIcon Symbol="Copy20"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource PlanSecondaryTextBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Load More -->
        <Button Content="加载更多笔记"
                Command="{Binding LoadMoreCommand}"
                Style="{StaticResource PlanChipButtonStyle}"
                HorizontalAlignment="Center"
                Margin="0,2,0,4"
                Visibility="{Binding HasMoreNotes, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</UserControl>
