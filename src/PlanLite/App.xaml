<Application x:Class="PlanLite.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:PlanLite.Helpers"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Resources/PlanLiteStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
            <helpers:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
            <helpers:StatusToTextConverter x:Key="StatusToText" />
            <helpers:StatusToBrushConverter x:Key="StatusToBrush" />
            <helpers:StatusToBadgeBackgroundConverter x:Key="StatusToBadgeBg" />
            <helpers:CompletedOpacityConverter x:Key="CompletedOpacity" />
            <helpers:CompletedTextDecorationsConverter x:Key="CompletedDecorations" />
            <helpers:EnumEqualsConverter x:Key="EnumEquals" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
